{
  "name": "improve-engine-performance",
  "note": "The optimisation pass: find out what is costing compile time and runtime visibility, apply what structural_audit recommends with brush_set_detail, and confirm the map is still the same map. The detailed copy is saved beside the original, so the invariants still judge the untouched work map; with --compile, compile_ab measures the difference. detail-pass covers the same loop on a map this repo owns.",
  "fixture": "corpus/real/ut4_woolis.map",
  "steps": [
    {
      "tool": "map_open",
      "as": "open",
      "args": {
        "path": "{work}"
      },
      "expect": {
        "round_trip.identical": true
      }
    },
    {
      "tool": "structural_audit",
      "as": "audit",
      "args": {
        "grid": 8
      },
      "expect": {
        "totals.structural_brushes": {
          "$gte": 1
        },
        "totals.candidates": {
          "$gte": 1
        },
        "estimated_portal_reduction_total": {
          "$gte": 1
        }
      }
    },
    {
      "tool": "map_stats",
      "as": "stats",
      "args": {},
      "expect": {
        "structural_brushes": {
          "$gte": 1
        }
      }
    },
    {
      "tool": "shader_audit",
      "as": "shaders",
      "args": {},
      "continue_on_mismatch": true
    },
    {
      "tool": "map_save",
      "as": "save",
      "args": {},
      "expect": {
        "written": true,
        "modified_since_open": false
      }
    },
    {
      "tool": "brush_set_detail",
      "as": "detail",
      "args_from": {
        "brushes": "audit.candidates"
      }
    },
    {
      "tool": "map_save",
      "as": "save_detailed",
      "args": {
        "path": "{workspace}/detailed.map",
        "allow_non_identical": true
      },
      "expect": {
        "written": true
      }
    },
    {
      "tool": "compile_ab",
      "as": "ab",
      "needs_compile": true,
      "args": {
        "map_a": "{workspace}/baseline.map",
        "map_b": "{workspace}/detailed.map",
        "preset": "draft"
      },
      "expect": {
        "deltas.leafs.percent": {
          "$lt": 0
        },
        "summary.error": 0
      }
    }
  ],
  "invariants": [
    {
      "name": "round_trip_identical"
    },
    {
      "name": "no_playable_space_regression",
      "args": {
        "max_lost_fraction": 0.0
      }
    },
    {
      "name": "tool_result",
      "args": {
        "step": "audit",
        "path": "summary.error",
        "equals": 0
      }
    },
    {
      "name": "map_seals"
    }
  ]
}
